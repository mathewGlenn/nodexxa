{
  "name": "nodexxa",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm --filter dashboard build",
    "lint": "pnpm --filter dashboard lint",
    "typecheck": "pnpm --filter dashboard typecheck",
    "test": "pnpm --filter dashboard test",
    "test:integration": "pnpm --filter dashboard test:integration",
    "test:e2e": "pnpm --filter dashboard test:e2e",
    "test:agent": "cd agents/linux && go vet ./... && go test -race -count=1 ./..."
  }
}

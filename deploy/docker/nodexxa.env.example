# Copy outside the repository (e.g. /etc/nodexxa/nodexxa.env), chmod 600, fill in. Never commit real values.
POSTGRES_USER=nodexxa
POSTGRES_DB=nodexxa
POSTGRES_PASSWORD=CHANGE_ME_long_random
DATABASE_URL=postgresql://nodexxa:CHANGE_ME_long_random@db:5432/nodexxa

# 32 random bytes, base64 (`openssl rand -base64 32`). Back it up separately from database backups:
# a database backup is useless without it, and the two together expose every stored DO token.
NODEXXA_ENCRYPTION_KEY=
NODEXXA_ENCRYPTION_KEY_ID=k1
NODEXXA_ENCRYPTION_KEYS_PREVIOUS=

NODEXXA_PUBLIC_URL=https://nodexxa.example.internal
# Set to true only when the reverse proxy overwrites X-Forwarded-For / X-Forwarded-Host.
NODEXXA_TRUST_PROXY=true

# Optional connectors (disabled when empty).
SMTP_URL=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=

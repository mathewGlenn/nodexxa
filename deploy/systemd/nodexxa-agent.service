[Unit]
Description=Nodexxa monitoring agent (outbound-only, read-only collectors)
Documentation=https://github.com/mathewglenn/nodexxa/tree/main/deploy/systemd
After=network-online.target
Wants=network-online.target
# Revoked credentials or protocol mismatch exit with status 1 repeatedly; stop hammering the server.
StartLimitIntervalSec=1h
StartLimitBurst=10

[Service]
Type=simple
User=nodexxa-agent
Group=nodexxa-agent
ExecStart=/usr/local/bin/nodexxa-agent run --config /etc/nodexxa-agent/config.json
Restart=on-failure
RestartSec=30s

# --- Resource bounds ---
CPUQuota=10%
MemoryMax=96M
TasksMax=32
Nice=10

# --- Hardening: no privileges, read-only system, private /tmp, no new capabilities ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/nodexxa-agent
StateDirectory=nodexxa-agent
StateDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute is not set: the PM2 collector runs `pm2` (Node.js), whose JIT needs it off.
SystemCallArchitectures=native
SystemCallFilter=@system-service
# AF_UNIX: docker socket (if opted in) and systemd/D-Bus queries; INET/INET6: outbound HTTPS.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

# Docker opt-in only: add `SupplementaryGroups=docker` via a drop-in (root-equivalent access!).
# PM2 is per-user: to monitor another user's PM2 run a second instance as that user (see README).

[Install]
WantedBy=multi-user.target

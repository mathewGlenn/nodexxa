# Copy to .env (never commit). All secrets are injected at runtime.
DATABASE_URL=postgresql://nodexxa:CHANGE_ME@localhost:5432/nodexxa
# 32 random bytes, base64: `openssl rand -base64 32`. Keep separate from DB backups.
NODEXXA_ENCRYPTION_KEY=
# Optional: previous keys for decryption during rotation, "keyId:base64,keyId:base64".
NODEXXA_ENCRYPTION_KEYS_PREVIOUS=
NODEXXA_ENCRYPTION_KEY_ID=k1
# Public origin of the dashboard (used for CSRF origin checks and invite links).
NODEXXA_PUBLIC_URL=https://nodexxa.example.internal
# Optional notification connectors. Missing => integration shown as disabled.
SMTP_URL=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
